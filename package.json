{
  "name": "@nxttrack/platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm --filter @nxttrack/web build",
    "dev": "pnpm --filter @nxttrack/web dev",
    "start": "pnpm --filter @nxttrack/web start",
    "lint": "pnpm --filter @nxttrack/web lint",
    "typecheck": "pnpm --filter @nxttrack/web typecheck",
    "auth:audit": "node scripts/auth/audit-route-access.mjs && node scripts/auth/audit-auth-boundary.mjs",
    "auth:bootstrap-platform-owner": "node scripts/auth/bootstrap-platform-owner.mjs",
    "db:audit": "node scripts/db/audit-migrations.mjs",
    "db:rls-audit": "node scripts/db/audit-rls-coverage.mjs",
    "db:rls-role-smoke": "node scripts/db/rls-role-smoke.mjs",
    "db:verify-force-rls": "node scripts/db/verify-force-rls.mjs",
    "db:advisors": "node scripts/db/supabase-advisors.mjs",
    "db:inventory-production-read-only": "node scripts/db/inventory-production-read-only.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "deploy:package-standalone-assets": "node scripts/deploy/package-standalone-assets.mjs",
    "design:audit": "node scripts/design/audit-lovable-baseline.mjs",
    "design:capture-lovable": "pnpm --filter @nxttrack/web exec node scripts/capture-lovable-baseline.mjs",
    "design:capture-production": "pnpm --filter @nxttrack/web exec node scripts/capture-production-baseline.mjs",
    "design:log-visual-review": "pnpm --filter @nxttrack/web exec node scripts/log-production-visual-review.mjs",
    "release:truth": "node scripts/release/audit-repository-truth.mjs",
    "release:assert-source": "node scripts/release/assert-release-source.mjs",
    "release:audit-production-foundation": "node scripts/release/audit-production-foundation.mjs",
    "release:audit-production-mail": "node scripts/release/audit-production-mail-config.mjs",
    "release:audit-premium": "node scripts/release/audit-premium-productization.mjs",
    "release:audit-sprint31": "node scripts/release/audit-sprint31.mjs",
    "release:create-go-no-go": "node scripts/release/create-go-no-go-form.mjs",
    "release:write-artifact-probe": "node scripts/release/write-artifact-storage-probe.mjs",
    "release:write-evidence": "node scripts/release/write-release-evidence.mjs",
    "phase15:staging": "node scripts/staging/phase-15-validate.mjs",
    "phase16:flow": "node scripts/staging/phase-16-operational-flow.mjs",
    "staging:gate": "node scripts/staging/check-launch-gates.mjs",
    "staging:health": "node scripts/staging/health-smoke.mjs",
    "staging:runtime-smoke": "node scripts/staging/runtime-smoke.mjs",
    "staging:seed-demo": "node scripts/staging/seed-sprint31-demo.mjs",
    "operations:audit-communications": "node scripts/operations/audit-communications-foundation.mjs",
    "operations:monitor": "node scripts/operations/monitor-operational-health.mjs",
    "storage:backup": "node scripts/storage/object-backup.mjs export",
    "storage:verify-local": "node scripts/storage/object-backup.mjs verify-local",
    "storage:restore": "node scripts/storage/object-backup.mjs restore",
    "storage:verify-remote": "node scripts/storage/object-backup.mjs verify-remote",
    "test:billing-contract": "tsx --test tests/unit/billing-contract.test.ts",
    "test:intake-recommendations": "tsx --test tests/unit/intake-recommendations.test.ts",
    "security:audit-dependencies": "pnpm audit --prod --audit-level high",
    "sprint4:prepare-mutations": "node scripts/staging/prepare-sprint4-mutations.mjs",
    "sprint4:prepare-offer-edges": "node scripts/staging/prepare-sprint4-offer-edges.mjs",
    "sprint4:prepare-parent": "node scripts/staging/prepare-sprint4-parent.mjs",
    "sprint4:prepare-admin": "node scripts/staging/prepare-sprint4-admin.mjs",
    "sprint4:prepare-isolation": "node scripts/staging/prepare-sprint4-isolation.mjs",
    "sprint4:test-mutations": "pnpm --filter @nxttrack/web exec playwright test tests/e2e/sprint4-mutations.spec.ts --project=chromium-desktop",
    "sprint4:test-instructor": "pnpm --filter @nxttrack/web exec playwright test tests/e2e/sprint4-instructor-mutations.spec.ts --project=chromium-desktop",
    "sprint4:test-parent": "pnpm --filter @nxttrack/web exec playwright test tests/e2e/sprint4-parent-mutations.spec.ts --project=chromium-desktop",
    "sprint4:test-admin": "pnpm --filter @nxttrack/web exec playwright test tests/e2e/sprint4-admin-mutations.spec.ts --project=chromium-desktop",
    "sprint4:test-isolation": "pnpm --filter @nxttrack/web exec playwright test tests/e2e/sprint4-isolation.spec.ts --project=chromium-desktop",
    "sprint4:test-quality": "pnpm --filter @nxttrack/web exec playwright test tests/e2e/sprint4-quality-budgets.spec.ts --project=chromium-desktop",
    "sprint6:prepare-mollie": "node scripts/staging/prepare-mollie-sandbox.mjs",
    "sprint6:test-mollie": "pnpm --filter @nxttrack/web exec playwright test tests/e2e/mollie-sandbox.spec.ts --project=chromium-desktop --retries=0",
    "sprint6:verify-mollie": "node scripts/staging/verify-mollie-sandbox.mjs",
    "sprint6:prepare-incasso": "node scripts/staging/prepare-mollie-incasso-sandbox.mjs",
    "sprint6:test-incasso": "pnpm --filter @nxttrack/web exec playwright test tests/e2e/mollie-incasso-sandbox.spec.ts --project=chromium-desktop --retries=0",
    "sprint6:verify-incasso": "node scripts/staging/verify-mollie-incasso-sandbox.mjs",
    "sprint6:test-adjustment": "pnpm --filter @nxttrack/web exec playwright test tests/e2e/mollie-adjustment-sandbox.spec.ts --project=chromium-desktop --retries=0",
    "sprint6:verify-adjustment": "node scripts/staging/verify-mollie-adjustment-sandbox.mjs",
    "sprint6:prepare-mandate": "node scripts/staging/prepare-mollie-mandate-onboarding.mjs",
    "sprint6:test-mandate": "pnpm --filter @nxttrack/web exec playwright test tests/e2e/mollie-mandate-onboarding.spec.ts --project=chromium-desktop --retries=0",
    "sprint6:verify-mandate": "node scripts/staging/verify-mollie-mandate-onboarding.mjs",
    "test:e2e": "pnpm --filter @nxttrack/web test:e2e",
    "hardening:local": "pnpm run typecheck && pnpm run test:billing-contract && pnpm run test:intake-recommendations && pnpm run auth:audit && pnpm run db:audit && pnpm run db:rls-audit && pnpm run release:audit-sprint31 && pnpm run build && pnpm run deploy:package-standalone-assets && pnpm run staging:gate",
    "hardening:smoke": "pnpm run hardening:local && pnpm run test:e2e"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.15",
      "sharp": "0.35.0"
    }
  },
  "devDependencies": {
    "pg": "^8.22.0",
    "supabase": "^2.109.1",
    "tsx": "4.23.1"
  }
}
