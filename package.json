{
  "name": "@nxttrack/platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm --filter @nxttrack/web build",
    "dev": "pnpm --filter @nxttrack/web dev",
    "start": "pnpm --filter @nxttrack/web start",
    "lint": "pnpm --filter @nxttrack/web lint",
    "typecheck": "pnpm --filter @nxttrack/web typecheck",
    "auth:audit": "node scripts/auth/audit-route-access.mjs && node scripts/auth/audit-auth-boundary.mjs",
    "auth:bootstrap-platform-owner": "node scripts/auth/bootstrap-platform-owner.mjs",
    "db:audit": "node scripts/db/audit-migrations.mjs",
    "db:rls-audit": "node scripts/db/audit-rls-coverage.mjs",
    "db:rls-role-smoke": "node scripts/db/rls-role-smoke.mjs",
    "db:advisors": "node scripts/db/supabase-advisors.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "deploy:package-standalone-assets": "node scripts/deploy/package-standalone-assets.mjs",
    "phase15:staging": "node scripts/staging/phase-15-validate.mjs",
    "staging:gate": "node scripts/staging/check-launch-gates.mjs",
    "staging:health": "node scripts/staging/health-smoke.mjs",
    "staging:runtime-smoke": "node scripts/staging/runtime-smoke.mjs",
    "test:e2e": "pnpm --filter @nxttrack/web test:e2e",
    "hardening:local": "pnpm run typecheck && pnpm run auth:audit && pnpm run db:audit && pnpm run db:rls-audit && pnpm run build && pnpm run deploy:package-standalone-assets && pnpm run staging:gate",
    "hardening:smoke": "pnpm run hardening:local && pnpm run test:e2e"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "supabase": "^2.109.1"
  }
}
