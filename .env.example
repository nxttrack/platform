APP_ENV=development

# Tenant routing foundation. Comma-separated values.
PLATFORM_HOSTNAMES=localhost,127.0.0.1,::1,staging.nxttrack.nl
PLATFORM_MARKETING_HOSTNAMES=www.nxttrack.nl,nxttrack.nl
PLATFORM_ADMIN_HOSTNAMES=admin.nxttrack.nl
TENANT_BASE_DOMAINS=nxttrack.nl,localhost
RESERVED_TENANT_SUBDOMAINS=admin,api,app,platform,staging,www

# Release metadata exposed by /api/health in deployed environments.
RELEASE_COMMIT_SHA=
RELEASE_BUILD_TIME=

# Optional platform-wide GA4 property for the public NXTTRACK marketing pages.
# Tenant sites use their own GA4 measurement ID from tenant settings.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Supabase client-side values. Prefer the publishable key; legacy anon key is accepted for current GitHub environments.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase values. Never expose these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
RUN_DB_MIGRATIONS=false
DB_MIGRATE_DRY_RUN=false
AUTH_CODE_PEPPER=
EMAIL_SETTINGS_SECRET=

# Phase 13 staging hardening gates.
RUN_PLAYWRIGHT_SMOKE=false
STAGING_LAUNCH_STRICT=false
RLS_STAGING_TESTS_CONFIRMED=false
PLAYWRIGHT_STAGING_SMOKE_CONFIRMED=false
LOVABLE_VISUAL_CHECK_CONFIRMED=false
SUPABASE_BACKUPS_CONFIRMED=false
ROLLBACK_REHEARSAL_CONFIRMED=false

# Phase 13.7 runtime observability and smoke checks.
HEALTH_CHECK_DATABASE=auto
HEALTH_STRICT=false
REQUIRE_HEALTH_DATABASE=false
REQUIRE_HEALTH_COMMIT=false
RUNTIME_SMOKE_URL=https://staging.nxttrack.nl
RUNTIME_SMOKE_ROUTES=/,/login,/wachtwoord-vergeten,/nxttrack
TENANT_SMOKE_URL=
TENANT_SMOKE_ROUTES=/programmas,/intake
RLS_ROLE_SMOKE_REQUIRED=false

# Authenticated Playwright and RLS role smoke credentials. Use staging seed/test accounts only.
E2E_PLATFORM_OWNER_EMAIL=
E2E_PLATFORM_OWNER_PASSWORD=
E2E_TENANT_ADMIN_EMAIL=
E2E_TENANT_ADMIN_PASSWORD=
E2E_INSTRUCTOR_EMAIL=
E2E_INSTRUCTOR_PASSWORD=
E2E_PARENT_EMAIL=
E2E_PARENT_PASSWORD=
E2E_ALLOW_FORCE_PASSWORD_CHANGE=false

# First platform owner bootstrap. Enable only for the target environment that must seed the owner.
BOOTSTRAP_PLATFORM_OWNER=false
BOOTSTRAP_PLATFORM_OWNER_EMAIL=admin@nxttrack.nl
BOOTSTRAP_PLATFORM_OWNER_TEMP_PASSWORD=
BOOTSTRAP_PLATFORM_OWNER_RESET_PASSWORD=false

# Email foundation. NXTTRACK sends invite and password-reset mail itself. Prefer platform admin SendGrid API settings; env values are fallback.
# The Communication Hub additionally requires this explicit release gate before
# newsletters or other external campaign delivery may call the provider.
EMAIL_SENDING_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EHLO_HOSTNAME=nxttrack.nl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NXTTRACK
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=NXTTRACK

# Private uploads and CSV imports. Production must use required and a reachable
# ClamAV daemon through either its Unix socket or a private TCP endpoint.
UPLOAD_MALWARE_SCAN_MODE=required
CLAMAV_SOCKET_PATH=/var/run/clamav/clamd.ctl
CLAMAV_HOST=
CLAMAV_PORT=3310

# Interne geplande runners: Journey Bot (staging-only), Next Best Actions,
# review-only automation recipes, zwemanalytics/forecasts en fysieke
# participant-media expiry.
# Gebruik minimaal 32 willekeurige tekens.
CRON_SECRET=placeholder_add_later
INTERNAL_JOBS_ENABLED=false
JOURNEY_BOT_DEFAULT_ENABLED=false
JOURNEY_BOT_EMAIL_DOMAIN=nxttrack.test
ALLOW_JOURNEY_BOT_SEED=false

# Optional privacy-safe browser push. Generate a VAPID pair before enabling.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@nxttrack.nl
