APP_ENV=development

# Tenant routing foundation. Comma-separated values.
PLATFORM_HOSTNAMES=localhost,127.0.0.1,::1
TENANT_BASE_DOMAINS=localhost
RESERVED_TENANT_SUBDOMAINS=admin,api,app,platform,staging,www

# Supabase client-side values. Prefer the publishable key. ANON_KEY is supported as a legacy fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase values. Never expose these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Email foundation. SMTP first; SendGrid API can be added after provider approval.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SENDGRID_API_KEY=
