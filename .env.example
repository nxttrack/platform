APP_ENV=development

# Tenant routing foundation. Comma-separated values.
PLATFORM_HOSTNAMES=localhost,127.0.0.1,::1
TENANT_BASE_DOMAINS=localhost
RESERVED_TENANT_SUBDOMAINS=admin,api,app,platform,staging,www
DEFAULT_TENANT_SLUG=aquaswim-demo

# Supabase client-side values. Prefer the publishable key. ANON_KEY is supported as a legacy fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase values. Never expose these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
DATABASE_URL=
RUN_DB_MIGRATIONS=false
DB_MIGRATE_DRY_RUN=false

# Email foundation. SMTP first; SendGrid API can be added after provider approval.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SENDGRID_API_KEY=

# Future Billing & Incasso Engine. Placeholder values only; do not use real provider secrets here.
MOLLIE_API_KEY=placeholder_add_later
MOLLIE_WEBHOOK_SECRET=placeholder_add_later
MOLLIE_PROFILE_ID=placeholder_add_later
# Conditional only: SEPA is planned through Mollie; keep this empty unless a provider/contract requires explicit creditor metadata.
SEPA_CREDITOR_ID=placeholder_add_later

# Future Communication Escalation Engine. WhatsApp provider is not selected; WhatsApp/SMS stay inactive until policy and providers are approved.
WHATSAPP_BUSINESS_TOKEN=placeholder_add_later
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=placeholder_add_later
WHATSAPP_WEBHOOK_SECRET=placeholder_add_later
SMS_PROVIDER_API_KEY=placeholder_add_later
SMS_PROVIDER_WEBHOOK_SECRET=placeholder_add_later
PUSH_VAPID_PUBLIC_KEY=placeholder_add_later
PUSH_VAPID_PRIVATE_KEY=placeholder_add_later

# Future Integration Layer. Tenant-specific credentials need approved encrypted storage before activation. Native helpdesk does not need an external ticket provider.
BOOKKEEPING_API_KEY=placeholder_add_later
BOOKKEEPING_WEBHOOK_SECRET=placeholder_add_later
ACCESS_CONTROL_API_KEY=placeholder_add_later
ACCESS_CONTROL_WEBHOOK_SECRET=placeholder_add_later
ACCESS_CONTROL_BASE_URL=placeholder_add_later
# Optional later external CRM/ticket sync; not the core NXTTRACK helpdesk.
CRM_TICKET_SYSTEM_API_KEY=placeholder_add_later
NXTTRACK_WEBHOOK_SIGNING_SECRET=placeholder_add_later

# AI assistant layer. Suggestions are server-side only and require tenant-level approval before use.
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_MODEL=gpt-4.1-mini
AI_ASSISTANT_STORE_RESPONSES=false
AI_ASSISTANT_TIMEOUT_MS=12000
OPENAI_API_KEY=

# Production observability. Server-only; never prefix these with NEXT_PUBLIC_.
OBSERVABILITY_LOG_SINK_URL=
OBSERVABILITY_LOG_SINK_TOKEN=
OBSERVABILITY_LOG_SINK_PROVIDER=generic_http
ERROR_REPORTING_URL=
ERROR_REPORTING_TOKEN=
ERROR_REPORTING_PROVIDER=generic_http
UPTIME_MONITOR_URL=

# Browser E2E staging smoke. Required in CI for staging/production branch pushes.
E2E_BASE_URL=
E2E_SLOT_OFFER_TOKEN=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PARENT_EMAIL=
E2E_PARENT_PASSWORD=
E2E_INSTRUCTOR_EMAIL=
E2E_INSTRUCTOR_PASSWORD=
E2E_DOCUMENT_ID=
VISUAL_REQUIRE_AUTH=false
