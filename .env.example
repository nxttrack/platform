APP_ENV=development

# Tenant routing foundation. Comma-separated values.
PLATFORM_HOSTNAMES=localhost,127.0.0.1,::1
TENANT_BASE_DOMAINS=localhost
RESERVED_TENANT_SUBDOMAINS=admin,api,app,platform,staging,www
DEFAULT_TENANT_SLUG=aquaswim-demo

# Supabase client-side values. Prefer the publishable key. ANON_KEY is supported as a legacy fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase values. Never expose these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
DATABASE_URL=
RUN_DB_MIGRATIONS=false
DB_MIGRATE_DRY_RUN=false

# Email foundation. SMTP first; SendGrid API can be added after provider approval.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SENDGRID_API_KEY=

# Production observability. Server-only; never prefix these with NEXT_PUBLIC_.
OBSERVABILITY_LOG_SINK_URL=
OBSERVABILITY_LOG_SINK_TOKEN=
OBSERVABILITY_LOG_SINK_PROVIDER=generic_http
ERROR_REPORTING_URL=
ERROR_REPORTING_TOKEN=
ERROR_REPORTING_PROVIDER=generic_http
UPTIME_MONITOR_URL=

# Browser E2E staging smoke. Required in CI for staging/production branch pushes.
E2E_BASE_URL=
E2E_SLOT_OFFER_TOKEN=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PARENT_EMAIL=
E2E_PARENT_PASSWORD=
E2E_INSTRUCTOR_EMAIL=
E2E_INSTRUCTOR_PASSWORD=
E2E_DOCUMENT_ID=
