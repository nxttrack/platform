APP_ENV=development

# Tenant routing foundation. Comma-separated values.
PLATFORM_HOSTNAMES=localhost,127.0.0.1,::1,staging.nxttrack.nl
PLATFORM_MARKETING_HOSTNAMES=www.nxttrack.nl,nxttrack.nl
PLATFORM_ADMIN_HOSTNAMES=admin.nxttrack.nl
TENANT_BASE_DOMAINS=nxttrack.nl,localhost
RESERVED_TENANT_SUBDOMAINS=admin,api,app,platform,staging,www

# Supabase client-side values. Prefer the publishable key; legacy anon key is accepted for current GitHub environments.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase values. Never expose these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
RUN_DB_MIGRATIONS=false
DB_MIGRATE_DRY_RUN=false
AUTH_CODE_PEPPER=

# Phase 13 staging hardening gates.
RUN_PLAYWRIGHT_SMOKE=false
STAGING_LAUNCH_STRICT=false
RLS_STAGING_TESTS_CONFIRMED=false
PLAYWRIGHT_STAGING_SMOKE_CONFIRMED=false
LOVABLE_VISUAL_CHECK_CONFIRMED=false
SUPABASE_BACKUPS_CONFIRMED=false
ROLLBACK_REHEARSAL_CONFIRMED=false

# First platform owner bootstrap. Enable only for the target environment that must seed the owner.
BOOTSTRAP_PLATFORM_OWNER=false
BOOTSTRAP_PLATFORM_OWNER_EMAIL=admin@nxttrack.nl
BOOTSTRAP_PLATFORM_OWNER_TEMP_PASSWORD=
BOOTSTRAP_PLATFORM_OWNER_RESET_PASSWORD=false

# Email foundation. NXTTRACK sends invite and password-reset mail itself.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NXTTRACK
SENDGRID_API_KEY=
