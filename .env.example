APP_ENV=development

# Supabase client-side values. Use the publishable key, not a secret/service key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase values. Never expose these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Email foundation. SMTP first; SendGrid API can be added after provider approval.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SENDGRID_API_KEY=
