{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nxttrack:theme-package:1.0:assets",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "maxLength": 240,
        "pattern": "^assets/[a-zA-Z0-9_ ./-]+\\.(png|jpe?g|webp|avif)$"
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false
  },
  "maxProperties": 300
}
